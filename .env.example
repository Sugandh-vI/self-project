# Database — Supabase Postgres (README Section 10)
DATABASE_URL="postgresql://user:password@localhost:5432/self_project?schema=public"

# NextAuth.js — Google provider only for MVP (README Section 8)
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Cloudinary — poster normalization + user profile picture uploads (README Section 10)
CLOUDINARY_URL="cloudinary://<api_key>:<api_secret>@<cloud_name>"

# TMDb — movie + TV search (README Section 7)
TMDB_API_KEY=""

# AniList — anime search (README Section 7). Public GraphQL endpoint, no API key required.
ANILIST_API_URL="https://graphql.anilist.co"
