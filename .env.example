# Database — Supabase Postgres (README Section 10)
#
# Two URLs, deliberately:
#
#   DATABASE_URL — the app's runtime pool. MUST carry an explicit
#   connection_limit: Prisma defaults to (CPUs*2+1) = 21 on an 8-core machine,
#   which exceeds Supabase's session-pooler cap of 15 clients and produces
#   "FATAL: (EMAXCONNSESSION) max clients reached in session mode" plus P2024
#   pool timeouts under load. lib/prisma.ts also caps the pool defensively.
#   5 leaves room for `prisma migrate`/`studio` and a second dev server.
#
#   DIRECT_URL — migrations/DDL only (prisma migrate deploy, db push). Keeping
#   migrations off the app's pooled connection stops them from consuming
#   pooler client slots next to the dev server. Same host is fine (IPv4).
#
# On Vercel (serverless functions, many short-lived clients) prefer the
# transaction pooler for the runtime URL instead:
#   ...@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# Transaction mode does not support prepared statements, hence pgbouncer=true.
# Keep DIRECT_URL on the session pooler (5432) — DDL is not supported there.
#
# Local example (session pooler, IPv4):
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require&connection_limit=5"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require"

# NextAuth.js — Google provider only for MVP (README Section 8)
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Cloudinary — poster normalization + user profile picture uploads (README Section 10)
CLOUDINARY_URL="cloudinary://<api_key>:<api_secret>@<cloud_name>"

# TMDb — movie + TV search (README Section 7)
TMDB_API_KEY=""

# AniList — anime search (README Section 7). Public GraphQL endpoint, no API key required.
ANILIST_API_URL="https://graphql.anilist.co"
